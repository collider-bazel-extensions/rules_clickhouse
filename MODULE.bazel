"""rules_clickhouse: a hermetic, per-test ClickHouse server for Bazel.

  clickhouse_schema / clickhouse_server / clickhouse_health_check /
  clickhouse_test (see defs.bzl)

Pinned: ClickHouse 26.9.32.8 (the clickhouse-common-static release
archives, SHA-512 from upstream's .sha512 files).
"""

module(
    name = "rules_clickhouse",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")

# rules_shell is part of the public surface: clickhouse_test is an sh_test
# macro. Bazel 8+ removed `native.sh_test`.
bazel_dep(name = "rules_shell", version = "0.8.0")

# The toolchain hub `@clickhouse` and its lazy per-platform binary repos
# (`@clickhouse_<platform>`, fetched only for the platform a build needs).
# A root module's clickhouse.version() overrides this one; consumers need
# no extension wiring.
clickhouse = use_extension("//:extensions.bzl", "clickhouse")
clickhouse.version(version = "26.9.32.8")
use_repo(clickhouse, "clickhouse")

register_toolchains("@clickhouse//:all")

# ---- dev-only ------------------------------------------------------------------

bazel_dep(name = "rules_itest", version = "0.0.52", dev_dependency = True)
