#!/usr/bin/env bash
# clickhouse_health_check: exits 0 iff the paired clickhouse_server has
# written its env file (it does so only once /ping answers and the
# migrations and seeds have run).
set -euo pipefail

env_file="${TEST_TMPDIR:-${TMPDIR:-/tmp}}/__ENV_FILE_NAME__"
if [[ -f "$env_file" ]]; then
  exit 0
fi
echo "[clickhouse_health_check] env file not yet present: $env_file" >&2
exit 1
